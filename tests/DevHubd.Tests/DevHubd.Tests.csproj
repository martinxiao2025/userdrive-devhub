<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DevHubd.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 + Microsoft.Testing.Platform：测试项目必须是可执行程序，dotnet test 走 MTP -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 4.0.2 自带 Microsoft.Testing.Platform 2.5.1（mtp-v2），不再需要 Microsoft.NET.Test.Sdk -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- 官方日志断言工具：FakeLogger 抓取关键路径日志 -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DevHubd.Core\DevHubd.Core.csproj" />
    <ProjectReference Include="..\..\src\DevHubd.Mcp\DevHubd.Mcp.csproj" />
    <ProjectReference Include="..\..\src\DevHubd\DevHubd.csproj" />
  </ItemGroup>

</Project>
