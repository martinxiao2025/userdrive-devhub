{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userdrive-devhub/schemas/task.schema.json",
  "title": "devhub task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "prompt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "工作区内唯一；跨工作区由 workspace_id 隔离"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": ["ready", "blocked", "done", "cancelled"]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 0
    },
    "delivery": {
      "enum": ["review", "auto"],
      "default": "review",
      "description": "任务级档位只能收紧不能放松：全局为 dispatch_only 时 auto 不生效"
    },
    "writeScope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "相对工作区根的写入白名单；空数组表示只读"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "default": "implementer",
      "description": "执行角色；必须是 role_view 中已声明的角色，未知角色不降级"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "uniqueItems": true,
      "description": "前置任务 id；任一未 done 时任务视图为 blocked，不依赖自身"
    },
    "requiresApproval": {
      "type": "boolean",
      "default": false,
      "description": "产出必须人工审批后才算 delivered"
    },
    "source": {
      "type": "string",
      "maxLength": 200,
      "description": "来源渠道（可选，仅用于追溯，不参与调度）"
    }
  }
}
