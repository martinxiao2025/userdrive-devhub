<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DevHubd.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 数据访问统一走官方 EF Core；版本与 Microsoft.Data.Sqlite 显式对齐，不使用浮动版本 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!-- 模型通道统一抽象：官方 AI 抽象层 + 官方 OpenAI 适配器，锁定显式稳定版本 -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>

</Project>
